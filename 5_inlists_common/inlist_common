! For the sake of future readers of this file (yourself included),
! ONLY include the controls you are actually using.  DO NOT include
! all of the other controls that simply have their default values.

&star_job
! net 
	change_net = .true.
	new_net_name = 'pp_and_cno_extras.net' !'basic.net' 
	change_initial_net = .true.
	T9_weaklib_full_off = 0.0001d0
	T9_weaklib_full_on = 0.00011d0
	
! display on-screen plots
	pgstar_flag = .true.
	pause_before_terminate = .false.

! hydro 
	change_v_flag = .true.
	new_v_flag = .true. !.false.

	show_retry_counts_when_terminate = .true.
	show_timestep_limit_counts_when_terminate = .true.

	set_initial_model_number = .true.
	set_initial_cumulative_energy_error = .true.

/ !end of star_job namelist

&eos
  ! eos options
  ! see eos/defaults/eos.defaults
/ ! end of eos namelist

&kap
! kap options
! see kap/defaults/kap.defaults

	! OPAL asplund 2009 opacities.
	kap_file_prefix = 'OP_a09_nans_removed_by_hand'    ! 'gs98' 'a09'  'OP_a09' 'OP_gs98', 'oplib_...'
	kap_lowT_prefix = 'lowT_fa05_a09p'
	! kap_lowT_prefix = 'AESOPUS'
	! AESOPUS_filename = 'AESOPUS_AGSS09.h5' ! used only if kap_lowT_prefix = 'AESOPUS'
	! kap_lowT_prefix = 'lowT_Freedman11'
	use_Type2_opacities = .true. ! no helium burning.
	kap_CO_prefix   = 'a09_co' ! 'gs98_co' 'a09_co'
	Zbase = 0.020d0 ! for type-2 only.

	cubic_interpolation_in_X = .true.
	cubic_interpolation_in_Z = .true.

/ ! end of kap namelist

&controls
! log dir
	log_directory = 'LOGS'
	photo_directory = 'photos'

! Termination; final termination string
	xa_central_lower_limit_species(1) = 'h1'
	xa_central_lower_limit(1) = 5d-1

! composition controls
	x_ctrl(1) = 20d0	! deuterium abundance in ppm	
	x_ctrl(2) = 85d0  	! he3 abundance in ppm

! Mass
  	x_ctrl(3) = 4.0d0 ! Final mass

! How much mass do we accrete in exponential decay at end of accretion phase over time_decay years
	x_ctrl(4) = 0.05d0 ! Msun
	x_ctrl(5) = 4000.400040004001d0 ! Decay scale in order to capture decay of accretion rate
	x_ctrl(16) = 1000000d0 ! Time for final decay in years
! initial z, must be specified for initial composition to work
! initial y determined from initial_y = 0.248 + 1.4 * initial_z
	initial_z = 0.020d0

! Mesh and time delta coeffs (resolution)
	mesh_delta_coeff = 0.8 ! increase spatial resolution by lowering this
	! mesh_delta_coeff has to be consistent across pre-, burst- and post burst models
	! If you want more mesh change settings in inlist_*_mesh
	time_delta_coeff = 0.8 ! increase temporal resolution by lowering this
	x_ctrl(6) = 0.8  ! time delta coeff for custom routines

! accretion controls	
! Set accretion rate outside of potential bursts
! In run_star_extras, this is modified to accommodate initial increase and final decrease and potential bursts
	mass_change = 1d-5 ! Msun/yr
	x_ctrl(15) = 1d-5 ! For run_star_extras

! Accrete material with birth cloud composition
	accrete_same_as_surface = .false.
	accretion_zfracs = 8 

! Use other hooks (experimental)
	use_other_energy = .false. ! .false. = cold accretion, .true. = hot accretion
	use_other_adjust_mdot = .true. ! .true. for entire setup to function
	use_other_timestep_limit = .false. ! .false., but can be experimented with

! Atmosphere 
! Steindl+ needed tabulated atmospheres in seed phase, but in latest MESA version we can fully rely on T-tau
	mlt_make_surface_no_mixing = .true.     
	atm_option = 'T_tau'
	! atm_table = 'tau_100'

	atm_T_tau_relation = 'Eddington'
	atm_T_tau_opacity = 'varying' ! next best is 'iterated'

! Output frequency section:
	photo_interval         = 100
	photo_digits           = 8
	profile_interval       = 5000
	max_num_profile_models = 400000
	history_interval       = 1
	write_header_frequency = 10

! Energy equation model:
	energy_eqn_option = 'dedt'  
	fix_d_eos_dxa_partials = .true.
	xa_scale = 1d-5
	iter_for_resid_tol2 = 10
	convergence_ignore_equL_residuals = .true.

! Asteroseismology controls
	calculate_Brunt_N2 = .true.
	pulse_data_format = 'GYRE'
	write_pulse_data_with_profile = .true. ! does not work with tabulated atmospheres
	add_atmosphere_to_pulse_data = .true. ! pulsation data are written with each profile
	add_center_point_to_pulse_data = .true.
	keep_surface_point_for_pulse_data = .true.
	add_double_points_to_pulse_data = .true.
	interpolate_rho_for_pulse_data = .true.
	threshold_grad_mu_for_double_point = 5

! debugging_controls
	report_solver_progress = .true.	
	terminal_interval = 10
	max_abs_rel_run_E_err = -1
	report_solver_dt_info = .true.
	limit_for_rel_error_in_energy_conservation = 1d9
    hard_limit_for_rel_error_in_energy_conservation = 1d9

! Smoothing and glitches (tiny smoothing)
    num_cells_for_smooth_gradL_composition_term = 1
	threshold_for_smooth_gradL_composition_term = 0 ! can cause trouble with Ledoux enabled, so only a little smoothing
	num_cells_for_smooth_brunt_B = 1
	threshold_for_smooth_brunt_B = 0

! Solver section; from inlist_ppisn
! We use gold1 tolerances - the loosest:
! 	1. tol1 tightest tolerances
!	2. tol2 looser tolerances -> turned on after 5 attempts with tol1
! 	3. tol3 loosest tolerances -> turned on after 10 attempts with tol2
! Retry demanded if tol3 is not met.

	solver_max_tries_before_reject = 30
	max_tries_for_retry = 30
	max_tries_after_5_retries = 40
	max_tries_after_10_retries = 40
	max_tries_after_20_retries = 40
	relax_use_gold_tolerances = .false.
	use_gold_tolerances = .true.
	use_gold2_tolerances = .false.
	gold_iter_for_resid_tol2 = 10
	gold_iter_for_resid_tol3 = 10
	gold_tol_residual_norm3 = 1d-6
	gold_tol_max_residual3 = 1d-3
	gold_solver_iters_timestep_limit = 20

	solver_iters_timestep_limit = 50
	ignore_too_large_correction = .false.
	max_resid_jump_limit = 1d99
	corr_coeff_limit = 1d-2
	tiny_corr_coeff_limit = 200
	scale_max_correction = 1d-1


! Superadiabatic reduction 
! Quenches excess in gradT, can help with convergence mainly in surface layers
	use_superad_reduction = .true.
	superad_reduction_Gamma_limit = 0.3 !0.5d0
	superad_reduction_Gamma_limit_scale = 5
	superad_reduction_Gamma_inv_scale = 5
	superad_reduction_diff_grads_limit = 1d-2
	superad_reduction_limit = -1

! velocity drag
! Arises from hydro, but can cause noise
	use_drag_energy = .false. ! don't include drag energy in E equ, can cause spurious noise
	drag_coefficient = 1d0
	min_q_for_drag = 0.8d0

! Debugging
	! solver_test_partials_call_number = 649
	! solver_save_photo_call_number = 649
	! solver_test_partials_iter_number = 5
	! solver_test_partials_k = 1
	! solver_test_partials_equ_name = 'dv_dt'
	! solver_test_partials_var_name = 'all'
	! solver_test_partials_dx_0 = 1d-6
	! solver_test_partials_equ_name = 'opacity'

! Include other inlists with controls only
	! mixing controls
    MLT_option = 'Cox'
	use_Ledoux_criterion = .true.
	alpha_semiconvection = 1d-1
	semiconvection_option = 'Langer_85 mixing; gradT = gradr'
	mixing_length_alpha = 2.0d0
	! Convective premixing, maybe not compatible with overshooting
	! But maybe helps with off-center burning
	do_conv_premix = .true.

! Thermohaline mixing ! maybe helps with h2 off center burning
	! thermohaline_option = 'Brown_Garaud_Stellmach_13'
	! thermohaline_coeff = 1d0

! Any top overshooting
	overshoot_scheme(1) = 'exponential'
	overshoot_zone_type(1) = 'any'
	overshoot_zone_loc(1) = 'any'
	overshoot_bdy_loc(1) = 'top'
	overshoot_f(1) = 0.005d0
	overshoot_f0(1) = 0.001d0

! Any bottom overshooting
	overshoot_scheme(2) = 'exponential'
	overshoot_zone_type(2) = 'any'
	overshoot_zone_loc(2) = 'any'
	overshoot_bdy_loc(2) = 'bottom'
	overshoot_f(2) = 0.0025d0
	overshoot_f0(2) = 0.001d0

! see herwing 1996 and buchelle 2025 on overshooting D_min
    overshoot_D_min = 1d-2 ! 1d2 was mesa default (probably a typo)
	set_min_D_mix = .true.
	min_D_mix = 1d-2

	! burst parameters
    x_logical_ctrl(1) = .false. ! if .true. we generate bursts randomly
    x_integer_ctrl(1) = 0 ! Number of bursts

    x_ctrl(10) = 4 ! rise time (years)
    x_ctrl(11) = 100 ! plateau time (years)
    x_ctrl(12) = 80 ! decay time (years)
    x_ctrl(13) = 1d-3 ! max accretion rate (Msun/yr)
    x_ctrl(14) = 3.5 ! initiate burst at this mass (Msun)

    x_integer_ctrl(5) = 50 ! timestep at burst rise (rise time divided by this)

	! Timestep controls

! Limit timestep based on changes in global properties
! delta_*_limit are soft limits
! delta_*_hard_limit are hard limits which force retries; careful with these as they can crash the model.
! If hard limit crashes occur, consider relaxing the hard limits, set to -1 to disable.

! Changes in mass and accretion rate
	delta_lg_star_mass_limit = 1d-2
	delta_mdot_limit = 1d-2

! Surface luminosity
    delta_lgL_limit = 1d-3
    delta_lgL_hard_limit = -1

! Surface temperature
	delta_lgT_limit = 1d-3
	delta_lgT_hard_limit = -1

! Surface radius
	delta_lgR_limit = 1d-3
	delta_lgR_hard_limit = -1

! Luminosity from H-burning
    delta_lgL_H_limit = 1d-3
    delta_lgL_H_hard_limit = -1 ! This will force a lot of retries during intense mixing/burning episodes 
	! (fx growing/receding convective core or accretion bursts)
	! Should probably not be enabled unless you really need it

! Path in HR-diagram; useful to capture rapid excursions from fx accretion bursts
    delta_HR_limit = 1d-3
    delta_HR_hard_limit = -1

! Central density and temperature to help with rapid burning
	delta_lgRho_cntr_limit = 1d-3
	delta_lgRho_cntr_hard_limit = -1

! Maximum temperature changes
	delta_lgT_max_limit_only_after_near_zams = .false.
	delta_lgT_max_limit = 1d-3
	delta_lgT_max_hard_limit = -1

	delta_lgT_cntr_limit_only_after_near_zams = .false.
	delta_lgT_cntr_limit = 1d-3
	delta_lgT_cntr_hard_limit = -1

! Capture changes in anbundances of species on a cell-by-cell basis (dX_div_X)
! All these elements (except h2) develop steep chemical gradients in the convective core boundary region
! Only 9 species are allowed - why?
	dX_limit_species(1) = 'h2'
    dX_limit_species(1) = 'he3'
    dX_limit_species(2) = 'c12'
    dX_limit_species(3) = 'c13'
    dX_limit_species(4) = 'n14'
	dX_limit_species(5) = 'n15'
	dX_limit_species(6) = 'o16'
	dX_limit_species(7) = 'o17'
	dX_limit_species(8) = 'o18'
	dX_limit_species(9) = 'li7'
    dX_div_X_limit(1:9) = 1d-2
    dX_div_X_hard_limit(1:9) = 1d99
    dX_div_X_limit_min_X(1:9) = 1d-12
    dX_decreases_only(1:9) = .false.
    dX_div_X_at_high_T_limit(1:9) = 1d-2
    dX_div_X_at_high_T_hard_limit(1:9) = 1d99
    dX_div_X_at_high_T_limit_lgT_min(1:9) = 6

! Capture changes in luminosity gradient (cell-by-cell basis)
! Can help avoid "noisy" burning (maybe)
    ! dL_div_L_limit = 1d-1
    ! dL_div_L_hard_limit = -1
    ! dL_div_L_limit_min_L = -1d99 ! Lsun

! EbF:
! On the changes in total abundance of each isotope
! one of the most useful timestep controls, period 
	dX_nuc_drop_limit = 1d-3
	dX_nuc_drop_limit_at_high_T = -1
	dX_nuc_drop_min_X_limit = 1d-8 ! mininum abundance for dX_nuc_drop_limit to apply
	dX_nuc_drop_max_A_limit = 70   
	dX_nuc_drop_hard_limit = -1

! Varcontrol; limits how much structure can change in a step
    min_allowed_varcontrol_target = 1d-6

! Factors for adjusting timestep after retries or successful steps
	timestep_factor_for_retries = 0.6
	min_timestep_factor = 0.7
	max_timestep_factor = 1.1
	min_timestep_limit = 1d-12

	! meshing controls for pre-burst model
    max_allowed_nz = 1000000 ! we will never reach this

! minimum cell size in light of composition changes
! number one settings that will result in numerical convergence
	min_dq_for_xa = 1d-4 ! standard value is 1d-14, 1d-4 would be an upper limit -> allows for convergence
    min_dq_for_xa_convective = -1 ! -1 means we use min_dq_for_xa for convection zones too
    min_dq_for_logT = 1d-4
    max_center_cell_dq = 1d-4
    max_dq = 1d-3


! Mesh refinement based on composition gradients (M.G. Pedersen+ 2018)
! All these elements (except h2) develop steep chemical gradients in the convective core boundary region
! Only 9 species are allowed - why?
    ! xa_function_species(1) = 'h2'
    xa_function_species(1) = 'he3'
    xa_function_species(2) = 'c12'
    xa_function_species(3) = 'c13'
    xa_function_species(4) = 'n14'
	xa_function_species(5) = 'n15'
	xa_function_species(6) = 'o16'
	xa_function_species(7) = 'o17'
	xa_function_species(8) = 'o18'
	xa_function_species(9) = 'h2'

    xa_function_weight(1:9) = 60d0
    xa_function_param(1:9) = 1d-2

! Mesh refinement based on change in abundance per change in pressure
! All these elements (except h2) develop steep chemical gradients in the convective core boundary region
! Only 9 species are allowed - why?
    ! mesh_logX_species(1) = 'h2'
    mesh_logX_species(1) = 'he3'
    mesh_logX_species(2) = 'c12'
    mesh_logX_species(3) = 'c13'
    mesh_logX_species(4) = 'n14'
	mesh_logX_species(5) = 'n15'
	mesh_logX_species(6) = 'o16'
	mesh_logX_species(7) = 'o17'
	mesh_logX_species(8) = 'o18'
	mesh_logX_species(9) = 'h2'

    mesh_logX_min_for_extra(1:9) = -12
    mesh_dlogX_dlogP_extra(1:9) = 0.2d0
    mesh_dlogX_dlogP_full_on(1:9) = 1d-6
    mesh_dlogX_dlogP_full_off(1:9) = 1d-12

! Mesh refinement based on gradients in T, P, and R (M.G. Pedersen+ 2018) 
    T_function1_weight = 50d0
    P_function_weight = 40d0
    
    R_function_weight = 20d0
    R_function2_weight = 10d0
    R_function2_param1 = 1000d0

    ! E_function_weight = 80d0
    ! E_function_param = 20d0

! pp-mesh 
    ! mesh_dlog_pp_dlogP_extra = 0.1d0
	
/ ! end of controls namelist
