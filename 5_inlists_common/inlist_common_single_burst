! burst parameters
    x_logical_ctrl(1) = .false. ! if .true. we generate bursts randomly
    x_integer_ctrl(1) = 0 ! Number of bursts

    x_ctrl(10) = 4 ! rise time (years)
    x_ctrl(11) = 100 ! plateau time (years)
    x_ctrl(12) = 80 ! decay time (years)
    x_ctrl(13) = 1d-3 ! max accretion rate (Msun/yr)
    x_ctrl(14) = 3.5 ! initiate burst at this mass (Msun)

    x_integer_ctrl(5) = 50 ! timestep at burst rise (rise time divided by this)

    
