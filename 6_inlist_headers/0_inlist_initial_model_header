! This is the first inlist file that MESA reads when it starts.

! This file tells MESA to go look elsewhere for its configuration
! info. This makes changing between different inlists easier, by
! allowing you to easily change the name of the file that gets read.

&star_job

    read_extra_star_job_inlist(1) = .true.
    extra_star_job_inlist_name(1) = '1_inlists_initial_model/inlist_initial_model'
    ! read_extra_star_job_inlist(2) = .true.
    ! extra_star_job_inlist_name(2) = '4_inlists_post_burst/inlist_post_burst'


/ ! end of star_job namelist

&eos

    read_extra_eos_inlist(1) = .true.
    extra_eos_inlist_name(1) = '1_inlists_initial_model/inlist_initial_model'
    ! read_extra_eos_inlist(2) = .true.
    ! extra_eos_inlist_name(2) = '5_inlists_common/inlist_post_burst'

/ ! end of eos namelist

&kap

    read_extra_kap_inlist(1) = .true.
    extra_kap_inlist_name(1) = '1_inlists_initial_model/inlist_initial_model'
    ! read_extra_kap_inlist(2) = .true.
    ! extra_kap_inlist_name(2) = '5_inlists_common/inlist_common_mix'

/ ! end of kap namelist

&controls

    read_extra_controls_inlist(1) = .true.
    extra_controls_inlist_name(1) = '1_inlists_initial_model/inlist_initial_model'
    ! read_extra_controls_inlist(2) = .true.
    ! extra_controls_inlist_name(2) = '5_inlists_common/inlist_common_mix'
    ! read_extra_controls_inlist(3) = .true.
    ! extra_controls_inlist_name(3) = '5_inlists_common/inlist_common_mesh'
    

/ ! end of controls namelist

&pgstar

    read_extra_pgstar_inlist(1) = .true.
    extra_pgstar_inlist_name(1) = 'inlist_pgstar_initial_model'

/ ! end of pgstar namelist