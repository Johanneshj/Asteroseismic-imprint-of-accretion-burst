! For the sake of future readers of this file (yourself included),
! ONLY include the controls you are actually using.  DO NOT include
! all of the other controls that simply have their default values.

&star_job

! save a model at the end of the run
  	load_saved_model = .true.
	load_model_filename = 'models_to_load/0_initial_models/initial_model.mod'

! save model when terminate
	save_model_when_terminate = .false. ! can set to false if one just wants a constant accretion model
	save_model_filename = 'models_to_load/1_pre_burst_models/_pre_burst_model.mod'

! set initial composition and nuclear reaction network
  	set_uniform_initial_composition = .true.
  	initial_zfracs = 8 

! initial conditions
    set_initial_dt = .true.
	years_for_initial_dt = 0.0001d0

	show_retry_counts_when_terminate = .true.
	show_timestep_limit_counts_when_terminate = .true.

	set_initial_age = .true.
	initial_age = 0d0 ! in years
	set_initial_model_number = .true.
	set_initial_cumulative_energy_error = .true.

/ !end of star_job namelist

&controls
! LOGS and profiles
	star_history_name = 'history_pre_burst.data'
	profiles_index_name = 'profiles_pre_burst.index'
	profile_data_prefix = 'profile_pre_burst'

! initial model flag
	x_logical_ctrl(2) = .false.

! Whether or not we set initial composition (we only do this when we evolve a constant accretion model or the pre-burst model)
	x_logical_ctrl(5) = .false.

! integer control for whether to save a pre-burst model or post-burst model
	x_integer_ctrl(10) = 2 ! 0 = save pre-burst model 10 years before burst,
						   	! 1 = save post-burst model 1000 years after burst
						   	! 2 = terminate at h1 termination string

    varcontrol_target = 1d-4
	
/ ! end of controls namelist
